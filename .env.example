# --- live demo: deploy:demo / web:live / keeper:monad --------------------
# Testnet-only mnemonic. Account 0 deploys and pays; 1 is the allocator, 2-5 the
# agents, 9 the keeper. The server signs with 1-5 and 9 on visitors' behalf.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
DEMO_MNEMONIC=
# Lets the "Reset demo" button redeploy on a live chain (open the page with #admin=<token>).
DEMO_ADMIN_TOKEN=
# DEMO_GAS_PER_ACCOUNT_MON=0.4  # what each of the six demo accounts is filled to
# DEMO_GAS_FLOOR_MON=0.2        # the deployer refills an account that drops under this
# DEMO_TOPUP_PER_HOUR_MON=6     # ceiling on those refills, per hour
# OWNER_RESERVE_MON=1           # refills never take the deployer below this
# ORACLE_ACTIVE_SECONDS=5       # mark cadence while a browser is connected
# ORACLE_IDLE_SECONDS=300       # mark cadence while nobody is
# ORACLE_OBSERVE_SECONDS=60     # observe() cadence while watched (also right after a shock)
# PRESENCE_SECONDS=60
# AUTO_RESET=1                  # redeploy after a visitor leaves 2+ vaults frozen
# AUTO_RESET_MIN_FROZEN=2
# RESET_COOLDOWN_SECONDS=600
# RESET_MIN_BALANCE_MON=3
# MAX_GAS_PER_TX=1500000
# GAS_HEADROOM_PERCENT=50       # added to every gas estimate before signing
# TX_TIMEOUT_SECONDS=20         # how long the server waits for one of its own transactions
# SEND_TX_PER_MINUTE=40
# DESK_GAS_PER_HOUR=10000000    # signed gas the deployer spends on settleEpoch() and postLeaderboard(), per hour
# SETTLE_MAX_GAS=2000000        # cap on one settleEpoch()
# SETTLE_PER_MINUTE=3
# BATCH_MAX_PER_EPOCH=8         # intents queued for one epoch
# BATCH_MAX_PENDING=32          # intents queued in all
# REPORT_MIN_SECONDS=120        # spacing between two DP releases
# DEMO_REPORTER_SECRET=         # seeds a release's noise; a random value per boot when unset
# CONTROL_PER_MINUTE=12
# LOG_LOOKBACK_BLOCKS=90        # how far back a fresh page scans the execution feed
# READ_CACHE_MS=2000            # identical reads from several visitors share one upstream call
# PACK_READS=1                  # bundle a page's reads into one Multicall3 call (0 turns it off)
# PORT=3000

# --- single-vault deploy: deploy:monad --------------------------------------
DEPLOYER_PRIVATE_KEY=
AGENT_ADDRESS=
# BATCH_EPOCH_SECONDS=3600
# BATCH_SETTLEMENT_WINDOW_SECONDS=1800

# --- keeper:monad (standalone oracle; not next to web:live on the same deployment)
# DEPLOYMENT_FILE=              # default: contracts/deployments.latest.json, else web/deployments/<chainId>.json
# KEEPER_INTERVAL_SECONDS=10
# KEEPER_DRIFT_BPS=20
# KEEPER_BAND_BPS=1000
# KEEPER_POKE=1
