{
  "name": "mandate-protocol",
  "private": true,
  "type": "module",
  "scripts": {
    "web": "node web/server.mjs",
    "web:live": "node --env-file-if-exists=.env web/server.mjs --live",
    "compile": "node contracts/tools/compile.mjs",
    "test": "npm run test:contracts && npm run test:web",
    "test:contracts": "node --test contracts/test-js/*.test.mjs",
    "test:web": "node --test web/*.test.mjs",
    "deploy:monad": "node --env-file-if-exists=.env contracts/script/deploy.mjs",
    "deploy:demo": "node --env-file-if-exists=.env contracts/script/deploy-demo.mjs",
    "keeper:monad": "node --env-file-if-exists=.env contracts/script/keeper.mjs",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.0",
    "@openzeppelin/contracts": "5.4.0",
    "ethers": "^6.15.0",
    "hardhat": "^3.0.0",
    "solc": "0.8.37"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
